# --- required (or leave blank and enter them in the setup screen shown on first sign-in) ---
ARK_REPO_URL=https://github.com/you/your-storage-repo
ARK_GITHUB_TOKEN=github_pat_xxx           # fine-grained token: Contents read & write on that repo

# --- optional (all of these can also be changed in Settings) ---------------
# ARK_BRANCH=ark-data                       # storage branch (created automatically)
# ARK_ENCRYPT=false                         # encrypt new files
# ARK_PASSPHRASE=                           # required when encryption is on
# ARK_CHUNK_MB=48                           # split files into pieces of this size (max 95)
# ARK_STAGE_MB=64                           # upload data is pushed to GitHub in batches of this size (less disk/RAM)
# ARK_CACHE_MB=1024                         # disk cache for downloaded pieces
# ARK_MAX_UPLOAD_MB=20480                   # 0 = unlimited
# ARK_USERNAME=ark / ARK_PASSWORD=ark       # initial login (change it in Settings)
# ARK_SECRET_KEY=                           # keeps sessions and share links valid across restarts
# ARK_DATA_DIR=./data                       # settings, cache, temp files
# PORT=8000
